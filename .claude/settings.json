{
  "autoMemoryEnabled": false,
  "permissions": {
    "allow": [
      "Bash(git switch -c:*)"
    ],
    "deny": [
      "Bash(git checkout -b:*)",
      "Bash(git checkout -B:*)",
      "Bash(git checkout -q -b:*)",
      "Bash(git checkout -q -B:*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "shampoo guard edit --json",
            "timeout": 600
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "shampoo guard task --json",
            "timeout": 600
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "shampoo policies --json",
            "timeout": 600
          }
        ]
      }
    ]
  }
}
